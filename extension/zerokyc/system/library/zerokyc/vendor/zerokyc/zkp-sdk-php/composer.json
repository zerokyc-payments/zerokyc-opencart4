{
    "name": "zerokyc/zkp-sdk-php",
    "description": "Official PHP SDK for the ZeroKYC Pay crypto payment gateway (no-KYC checkout for digital services).",
    "type": "library",
    "license": "MIT",
    "keywords": ["zerokyc", "crypto", "payments", "gateway", "usdt", "bitcoin", "monero", "ton", "whmcs", "woocommerce", "blesta"],
    "homepage": "https://zerokyc-payments.com",
    "support": {
        "docs": "https://zerokyc-payments.com/docs",
        "source": "https://github.com/zerokyc-payments/zkp-sdk-php",
        "issues": "https://github.com/zerokyc-payments/zkp-sdk-php/issues",
        "security": "https://github.com/zerokyc-payments/zkp-sdk-php/blob/main/SECURITY.md"
    },
    "authors": [
        {"name": "ZeroKYC Payments", "homepage": "https://zerokyc-payments.com"}
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {"ZeroKYC\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"ZeroKYC\\Tests\\": "tests/"}
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
